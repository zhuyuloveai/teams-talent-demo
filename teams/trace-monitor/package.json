{
  "name": "trace-monitor-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Trace end-to-end monitoring frontend (Vue 3 + Element Plus rewrite, separate from the trace_server/backend backend)",
  "files": [
    "dist"
  ],
  "main": "./dist/trace-monitor-vue.umd.cjs",
  "module": "./dist/trace-monitor-vue.js",
  "types": "./dist/trace-monitor-vue.d.ts",
  "exports": {
    ".": {
      "types": "./dist/trace-monitor-vue.d.ts",
      "import": "./dist/trace-monitor-vue.js",
      "require": "./dist/trace-monitor-vue.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/copy-types.mjs",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "element-plus": "^2.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.83.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
