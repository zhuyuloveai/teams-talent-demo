# ============================================================
# Trace Monitor 后端配置模板（Teams 演示内嵌版）
# 复制为 trace-server/.env 后按需修改（.env 不入库）
# 说明：demo 服务端启动时会用环境变量覆盖以下值，
#       默认端口 8013、file 模式、读写同一个 iCode 采集目录。
# ============================================================

# ---- 存储后端（查询端）----
# file（读取 OTLP 直写 JSONL）| database（查询 PostgreSQL）
STORAGE_BACKEND=file

# 数据库连接（STORAGE_BACKEND=database 时使用）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/trace_db

# JSONL 目录（file 模式，查询端读、OTLP 接收端写，两处共用）
# 默认由 demo 服务端按 DEMO_TRACE_DATA_DIR 注入，指向本文件所在目录下的 trace_data/
DATA_FILE=trace_data

# ---- 服务监听 ----
HOST=127.0.0.1
PORT=8013

# ---- OTLP 接收 ----
# demo 内嵌版默认开启：iCode 启动脚本（start-icode-trace2.bat）直接上报到本服务，
# 不再需要容器版 trace2 的 :8011。OTLP_FILE_DIR 留空即沿用 DATA_FILE。
OTLP_ENABLED=1
OTLP_PATH=/v1/traces
OTLP_SINK=file
OTLP_FILE_DIR=
OTLP_DEFAULT_PROJECT_ID=icode
