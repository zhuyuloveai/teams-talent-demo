# ============================================================
# Trace Monitor backend config template (embedded Teams demo version)
# Copy to trace-server/.env and adjust as needed (.env is not committed)
# Note: the demo server overrides these values with environment variables at startup;
#       defaults are port 8013, file mode, and one shared iCode collection directory for reads and writes.
# ============================================================

# ---- Storage backend (query side) ----
# file (read JSONL written directly by OTLP) | database (query PostgreSQL)
STORAGE_BACKEND=file

# Database connection (used when STORAGE_BACKEND=database)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/trace_db

# JSONL directory (file mode; read by the query side and written by the OTLP receiver)
# Injected by the demo server from DEMO_TRACE_DATA_DIR by default; points to trace_data/ next to this file
DATA_FILE=trace_data

# ---- Server listen address ----
HOST=127.0.0.1
PORT=8013

# ---- OTLP ingestion ----
# Enabled by default in the embedded demo: the iCode launch script (start-icode-trace2.bat) reports directly to this service,
# so the containerized trace2 on :8011 is no longer needed. Leave OTLP_FILE_DIR empty to use DATA_FILE.
OTLP_ENABLED=1
OTLP_PATH=/v1/traces
OTLP_SINK=file
OTLP_FILE_DIR=
OTLP_DEFAULT_PROJECT_ID=icode
